<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight: the WebView then reports prefers-color-scheme from the system setting -->
    <style name="AppTheme" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/page</item>
    </style>
</resources>

# --- Mode de KHN -------------------------------------------------------------
# sim     : marché synthétique, aucun réseau (pour essayer)
# paper   : prix réels Binance, ordres simulés par KHN (recommandé pour commencer)
# testnet : prix et ordres sur le testnet Binance (argent fictif, achat seulement)
# live    : argent réel chez Kraken. Verrouillé tant que les conditions de l'onglet Réel
#           ne sont pas remplies : en attendant, chaque ordre est seulement validé (essai à blanc).
KHN_MODE=paper

# Mot de passe de l'interface (obligatoire, long et unique)
KHN_PASSWORD=

# Capital de démo en francs CFP
KHN_CAPITAL_XPF=1000

# Marchés surveillés (paires USDT de Binance)
KHN_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# --- Clés (ne jamais les partager ni les envoyer par message) ---------------
# Testnet Binance : https://testnet.binance.vision → Log In with GitHub → Generate HMAC_SHA256 Key
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

# Claude (analyse des vidéos et questions libres) : https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
KHN_MODEL=claude-opus-5-5

# Kraken (mode live uniquement) : clé SANS le droit « Withdraw Funds »
KRAKEN_KEY=
KRAKEN_SECRET=
# Capital réel minimum pour débloquer le réel (XPF)
KHN_LIVE_MIN_XPF=60000

# Notifications sur téléphone (optionnel) : appli ntfy, sujet difficile à deviner
# ex. https://ntfy.sh/khn-un-nom-long-et-secret
KHN_NTFY_URL=

# --- HTTPS (optionnel) : ton nom de domaine, ex. khn.duckdns.org ------------
KHN_DOMAIN=
